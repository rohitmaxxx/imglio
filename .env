# Copy this to .env in the repo root before running `docker compose up --build`.
# docker-compose.yml reads this file automatically. No secrets are committed —
# fill in real values locally / in your deployment environment.

# ---- Host ports ----
NGINX_PORT=80
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ---- Backend (FastAPI) ----
# Must be overridden to a long random value in production.
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRE_MINUTES=10080

# Comma-separated list of origins the browser is allowed to load the app from.
# Defaults cover both the nginx entrypoint and the frontend's own published
# port — add your own (e.g. a public domain) if you access the stack another way.
FRONTEND_ORIGIN=http://localhost,http://localhost:3000,https://pixanzo.com,https://www.pixanzo.com

ANALYTICS_DB=data/analytics.db

# If SMTP_USER/SMTP_PASS are left blank, OTPs are printed to the backend
# container logs instead of emailed (dev mode).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Frontend (Next.js) ----
# Backend URL reachable from the USER'S BROWSER (baked into the client bundle
# at build time). For local `docker compose up` this is the backend's
# published host port. In production, point this at your public API
# domain/port and rebuild the frontend image.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Used to build absolute URLs for metadata, Open Graph, robots.txt, sitemap.xml —
# this value is baked into the frontend at BUILD time, so it must be the real
# public domain, not the nginx entrypoint. Override to http://localhost for a
# purely local build/test where you don't want production URLs in the metadata.
NEXT_PUBLIC_SITE_URL=https://pixanzo.com
