# JWT auth
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRE_MINUTES=10080

# CORS — the deployed frontend origin (no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000

# Analytics SQLite path (defaults to backend/data/analytics.db)
ANALYTICS_DB=data/analytics.db

# OTP email delivery — if unset, OTPs are printed to the server console (dev mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
