# Backend API base URL — used by client components and server-side fetches.
# Use 127.0.0.1 rather than "localhost" for local dev: on some systems Node
# resolves "localhost" to the IPv6 ::1 first, which fails if the backend is
# only bound to the IPv4 loopback.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Same value, read server-side by the auth route handlers (no NEXT_PUBLIC_ prefix
# so it's never bundled into client JS)
API_URL=http://127.0.0.1:8000

# Used to build absolute URLs for metadata, Open Graph, robots.txt, sitemap.xml.
# This is a local-dev-only template — in production (see root .env.example,
# used by docker-compose) this must be the real public domain, e.g.
# https://pixanzo.com, since it's baked into the frontend at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
